<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="cn.scnet.agent"
    android:versionCode="@VER_CODE@"
    android:versionName="@VER_NAME@">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:usesCleartextTraffic="@CLEARTEXT@"
        android:hardwareAccelerated="true"
        android:theme="@android:style/Theme.DeviceDefault.Light.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".LoginActivity" android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ProfileActivity" android:exported="false" />
        <activity android:name=".JobsActivity" android:exported="false" />
        <activity android:name=".JobDetailActivity" android:exported="false" />
        <activity android:name=".JobSubmitActivity" android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity android:name=".FilesActivity" android:exported="false" />
        <activity android:name=".OcrActivity" android:exported="false" />
        <activity android:name=".MarketActivity" android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity android:name=".AiHubActivity" android:exported="false" />
        <activity android:name=".WebActivity" android:exported="false" />
    </application>
</manifest>
